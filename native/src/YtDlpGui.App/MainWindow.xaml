<Window x:Class="YtDlpGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="yt_dlp_gui Native v2.0.0"
        Icon="Assets/app.ico"
        Width="820"
        Height="650"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20,24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="视频下载器" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Windows 原生版 · yt-dlp + FFmpeg" />
                </StackPanel>
                <ComboBox x:Name="ThemeComboBox"
                          Grid.Column="1"
                          Width="118"
                          Margin="16,0,12,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Theme, Mode=OneWay}"
                          ToolTip="界面主题"
                          AutomationProperties.Name="界面主题"
                          SelectionChanged="ThemeComboBox_SelectionChanged" />
                <Border Grid.Column="2"
                        Padding="11,6"
                        VerticalAlignment="Center"
                        Background="{DynamicResource StateBadgeBrush}"
                        CornerRadius="14">
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" Text="{Binding StateLabel}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,18">
                <Border Padding="18" Background="{DynamicResource CardBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="视频 URL" />
                        <TextBox x:Name="UrlTextBox"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotBusy}"
                                 ToolTip="支持 YouTube、Bilibili 及 yt-dlp 支持的网站"
                                 AutomationProperties.Name="视频 URL" />

                        <TextBlock Margin="0,16,0,7" Style="{StaticResource SectionLabelStyle}" Text="嗅探结果" />
                        <ComboBox ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding SelectedFormat}"
                                  IsEnabled="{Binding HasFormats}"
                                  AutomationProperties.Name="下载格式" />

                        <TextBlock Margin="0,16,0,7" Style="{StaticResource SectionLabelStyle}" Text="输出目录" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputDirectory, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="输出目录" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource BaseButtonStyle}" Content="选择" Click="ChooseOutputDirectory_Click" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource BaseButtonStyle}" Content="打开" Click="OpenOutputDirectory_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander Margin="0,12,0,0"
                          IsExpanded="{Binding IsCookiePanelExpanded}"
                          Foreground="{DynamicResource TextBrush}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="手动 Cookie" />
                            <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CookieScopeLabel}" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Margin="0,8,0,0" Padding="18" Background="{DynamicResource CardBrush}" CornerRadius="10">
                        <StackPanel>
                            <CheckBox Margin="0,0,0,10"
                                      Foreground="{DynamicResource TextBrush}"
                                      Content="匿名嗅探失败后，尝试 Firefox、Edge、Chrome 登录态"
                                      IsChecked="{Binding TryBrowserCookies}"
                                      IsEnabled="{Binding IsNotBusy}" />
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="粘贴 Netscape 格式 Cookie。内容只写入临时文件，关闭程序即删除，并且只对当前网站生效。" />
                            <TextBox Height="104"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     Text="{Binding CookieText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Netscape Cookie" />
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Content="临时保存 Cookie"
                                    IsEnabled="{Binding CanSaveCookie}"
                                    Click="SaveCookie_Click" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding PrimaryButtonText}"
                            IsEnabled="{Binding CanRunPrimaryAction}"
                            Click="PrimaryAction_Click" />
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="取消"
                            Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="Cancel_Click" />
                    <Button Grid.Column="2"
                            Margin="10,0,0,0"
                            Style="{StaticResource BaseButtonStyle}"
                            Content="更新 yt-dlp"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="UpdateYtDlp_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,14"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,10"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding ToolSummary}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>

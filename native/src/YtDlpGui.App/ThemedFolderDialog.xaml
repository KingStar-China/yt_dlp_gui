<Window x:Class="YtDlpGui.App.ThemedFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择视频输出目录"
        Icon="Assets/app.ico"
        Width="650"
        Height="520"
        MinWidth="560"
        MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="21" FontWeight="SemiBold" Text="选择视频输出目录" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="双击进入文件夹，或选中后直接确认。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    MinHeight="34"
                    Padding="11,5"
                    Style="{StaticResource BaseButtonStyle}"
                    Content="此电脑"
                    Click="ComputerButton_Click" />
            <Button Grid.Column="1"
                    MinHeight="34"
                    Margin="7,0,0,0"
                    Padding="11,5"
                    Style="{StaticResource BaseButtonStyle}"
                    Content="下载"
                    Click="DownloadsButton_Click" />
            <Button Grid.Column="2"
                    MinHeight="34"
                    Margin="7,0,0,0"
                    Padding="11,5"
                    Style="{StaticResource BaseButtonStyle}"
                    Content="上一级"
                    Click="UpButton_Click" />
            <TextBox x:Name="PathTextBox"
                     Grid.Column="3"
                     MinHeight="34"
                     Margin="10,0,0,0"
                     Padding="9,5"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="当前目录"
                     KeyDown="PathTextBox_KeyDown" />
            <Button Grid.Column="4"
                    MinHeight="34"
                    Margin="7,0,0,0"
                    Padding="11,5"
                    Style="{StaticResource BaseButtonStyle}"
                    Content="转到"
                    Click="GoButton_Click" />
        </Grid>

        <ListBox x:Name="FoldersList"
                 Grid.Row="2"
                 AutomationProperties.Name="子文件夹"
                 MouseDoubleClick="FoldersList_MouseDoubleClick"
                 SelectionChanged="FoldersList_SelectionChanged"
                 KeyDown="FoldersList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="2,0,11,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Text="{Binding Icon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding FullPath}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Margin="2,9,2,0"
                   FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedPathTextBlock"
                       Grid.Column="0"
                       Margin="2,0,14,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    MinWidth="88"
                    Style="{StaticResource BaseButtonStyle}"
                    Content="取消"
                    IsCancel="True" />
            <Button x:Name="SelectButton"
                    Grid.Column="2"
                    MinWidth="126"
                    Margin="9,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="选择文件夹"
                    IsDefault="True"
                    Click="SelectButton_Click" />
        </Grid>
    </Grid>
</Window>

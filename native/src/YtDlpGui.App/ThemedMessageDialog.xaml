<Window x:Class="YtDlpGui.App.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Icon="Assets/app.ico"
        Width="440"
        MinHeight="210"
        MaxHeight="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconSurface"
                    Width="42"
                    Height="42"
                    Margin="0,1,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    CornerRadius="21">
                <TextBlock x:Name="IconText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningTextBrush}"
                           Text="!" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="DialogTitleText"
                           FontSize="19"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="360"
                              Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DialogMessageText"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Button x:Name="OkButton"
                Grid.Row="1"
                MinWidth="96"
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}"
                Content="确定"
                Click="OkButton_Click" />
    </Grid>
</Window>
